# =====================================================================
#  مناقيش — environment variables (نسخة الاستضافة الثابتة)
#
#  انسخ هذا الملف باسم .env.local محليًا، وأضف نفس القيم في:
#    - GitHub Pages: إعدادات الـ workflow (أو اتركها فارغة)
#    - Firebase Hosting: لا يحتاج أي متغير هنا (كلها public)
#
#  المتغيرات أدناه كلها PUBLIC تظهر في المتصفح — هذا مقصود وآمن لأن
#  كل الحماية تعتمد على RLS في Supabase ومحفزات قاعدة البيانات.
#  مفتاح الخدمة السري لم يعد في الموقع إطلاقًا: صار في أسرار
#  Edge Function فقط (انظر HOSTING.md).
# =====================================================================

# --- Supabase (مطلوب) -------------------------------------------------
# عنوان مشروعك من Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# المفتاح العام (publishable) — يظهر للمتصفح وموجود داخل الإضافة، وهو
# آمن للنشر لأن كل الجداول محمية بـ RLS. نفسه موجود في manaqish-config.js
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# --- اختياري ----------------------------------------------------------
# GitHub Pages لمواقع المشاريع يخدم الموقع تحت /<repo>/ — اضبط القيمة
# وقت البناء في الـ workflow (خطوة Build) وليس هنا.
# NEXT_PUBLIC_BASE_PATH=

# سقف عدد صفوف التصدير الواحد (افتراضي 10000 صف، بحد أقصى 50000 —
# التصدير يُبنى في المتصفح الآن)
# NEXT_PUBLIC_EXPORT_ROW_LIMIT=10000
