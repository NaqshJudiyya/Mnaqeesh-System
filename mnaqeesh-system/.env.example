# --- Supabase ---------------------------------------------------------
# نفس المشروع الموجود أصلًا في إعدادات الإضافة (manaqish-config.js)
NEXT_PUBLIC_SUPABASE_URL=https://xmxcdionvhshvtvsdauu.supabase.co

# المفتاح العام (publishable) — نفسه الموجود في الإضافة، ويظهر للمتصفح
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7RDGcclPD02zao2n2awHCw_hcSwg1sd

# مفتاح الخدمة (service_role) — سري تمامًا، من Supabase:
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

